# Copy to /etc/brightcone/brightcone.env on the server. Never commit the real file.
DATABASE_URL=postgres://brightcone:replace-with-your-database-password@127.0.0.1:5432/brightcone
JWT_SECRET=replace-with-an-independent-random-64-character-secret
SESSION_SECRET=replace-with-another-independent-random-64-character-secret
LOCO_ENV=production
APP_URL=https://hr.example.com
PORT=5150
